{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenchang.local/publishing/v1/xiaohongshu",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "platform": {
      "const": "xiaohongshu"
    },
    "cover_title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 20
    },
    "post_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "description": {
      "type": "string",
      "minLength": 150,
      "maxLength": 300
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30
      },
      "minItems": 0,
      "maxItems": 10
    },
    "cards_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "platform",
    "cover_title",
    "post_title",
    "description",
    "tags",
    "cards_ref"
  ]
}
