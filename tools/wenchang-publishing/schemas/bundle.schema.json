      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "built_at": {
