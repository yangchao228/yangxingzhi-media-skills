{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenchang.local/publishing/v1/render",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preview": {
      "type": "string",
      "minLength": 1
    },
    "fragment": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "status": {
      "const": "local_ready"
    },
    "transfer_status": {
      "const": "not_started"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ref",
          "sha256"
        ]
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "ref",
          "sha256",
          "bytes"
        ]
      },
      "minItems": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "zhihu",
              "wechat",
              "xiaohongshu"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          }
        },
        "required": [
          "code",
          "message",
          "action",
          "severity"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "version",
    "preview",
    "status",
    "transfer_status",
    "inputs",
    "outputs",
    "warnings"
  ]
}
