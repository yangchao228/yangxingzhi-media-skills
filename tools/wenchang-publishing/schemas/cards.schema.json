{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenchang.local/publishing/v1/cards",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 18,
      "uniqueItems": true
    }
  },
  "required": [
    "images"
  ]
}
